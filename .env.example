# Copy this file to ".env" and fill in your own values. Never commit ".env".

POSTGRES_DB=hykon_iot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-database-password

# At least 32 characters of random text (base64 is fine)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Address of the website in the browser (CORS). Local: http://localhost   Server: https://app.yourdomain.com
APP_CORS_ALLOWED_ORIGINS=http://localhost

# First-start accounts (only created when they do not exist yet)
HYKON_ADMIN_EMAIL=hykon_admin@gmail.com
HYKON_ADMIN_PASSWORD=change-this-admin-password
OVERSEER_EMAIL=distributor_admin@gmail.com
OVERSEER_PASSWORD=change-this-overseer-password

# Optional host ports
WEB_PORT=80
BACKEND_PORT=8080
